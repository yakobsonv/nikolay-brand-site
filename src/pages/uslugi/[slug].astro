---
// Страницы услуг: /uslugi/<slug>/ — по одной на направление из src/data/directions.
import DirectionPage from '../../components/brand/DirectionPage.astro';
import { SERVICES } from '../../data/directions';

export function getStaticPaths() {
  return SERVICES.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}

const { d } = Astro.props;
---

<DirectionPage d={d} />
