---
// Знак и название компании. Логотипа у клиента нет (на дисках только знак поставщика SKS),
// поэтому знак — простая типографская марка: три кирпича вперевязку в красном квадрате.
// Это ВРЕМЕННЫЙ знак до логотипа от клиента — заменяется в одном месте.
import { BRAND } from '../../lib/sites';

interface Props {
  /** светлый вариант для тёмного фона */
  inverse?: boolean;
  class?: string;
}

const { inverse = false, class: className } = Astro.props;
const [first, ...rest] = BRAND.split(' ');
---

<span class:list={['logo', inverse && 'logo--inverse', className]}>
  <svg class="logo__mark" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true" focusable="false">
    <rect width="40" height="40" rx="10" fill="var(--color-brand)" />
    <g fill="#fff">
      <rect x="7" y="9" width="12" height="6" rx="1.2" />
      <rect x="21" y="9" width="12" height="6" rx="1.2" />
      <rect x="7" y="17" width="5" height="6" rx="1.2" />
      <rect x="14" y="17" width="12" height="6" rx="1.2" />
      <rect x="28" y="17" width="5" height="6" rx="1.2" />
      <rect x="7" y="25" width="12" height="6" rx="1.2" />
      <rect x="21" y="25" width="12" height="6" rx="1.2" />
    </g>
  </svg>
  <span class="logo__text">
    <span class="logo__word">{first}</span>
    {rest.length > 0 && <span class="logo__word logo__word--second">{rest.join(' ')}</span>}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text);
    font-family: var(--font-head);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.01em;
  }

  .logo--inverse { color: var(--color-on-dark); }

  .logo__mark {
    flex: none;
    width: 40px;
    height: 40px;
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    font-size: 17px;
    text-transform: lowercase;
  }

  .logo__word--second { color: var(--color-brand); }
  .logo--inverse .logo__word--second { color: var(--color-brand-on-dark); }
</style>
